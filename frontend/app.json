{
  "expo": {
    "name": "PSG Selling Tools",
    "slug": "frontend",
    "version": "37.5.0",
    "orientation": "default",
    "icon": "./assets/images/psg-icon.png",
    "scheme": "psgsellingtools",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.sellingtoolsmobile.r0cdrg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/psg-adaptive-foreground.png",
        "backgroundImage": "./assets/images/psg-adaptive-background.png"
      },
      "package": "com.emergent.sellingtoolsmobile.r0cdrg"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/psg-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/psg-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#A60101"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
